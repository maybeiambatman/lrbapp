{
  "name": "lrbapp",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-20-bullseye",
  "remoteUser": "node",
  "postCreateCommand": "npm install",
  "forwardPorts": [
    5173,
    4173
  ],
  "portsAttributes": {
    "5173": {
      "label": "Vite dev",
      "onAutoForward": "openBrowser"
    },
    "4173": {
      "label": "Vite preview"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "bradlc.vscode-tailwindcss"
      ]
    }
  },
  "remoteEnv": {
    "CHOKIDAR_USEPOLLING": "true"
  }
}
