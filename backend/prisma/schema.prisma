// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User management
model User {
  id        String   @id @default(cuid())
  name      String
  email     String?  @unique
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())

  // Relations
  createdTrips Trip[]        @relation("TripCreator")
  createdCourses Course[]    @relation("CourseCreator")
  scores      RoundScore[]
  communities Community[]   @relation("CommunityMembers")
  createdCommunities Community[] @relation("CommunityCreator")

  @@index([email])
}

// Golf Course
model Course {
  id        String   @id @default(cuid())
  name      String
  location  String?
  createdBy String
  createdAt DateTime @default(now())

  // Relations
  creator    User         @relation("CourseCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  holes      Hole[]
  tees       Tee[]
  trips      Trip[]       @relation("TripCourses")
  scores     RoundScore[]
  architects CourseArchitect[]

  @@index([createdBy])
}

model Hole {
  id       String @id @default(cuid())
  courseId String
  number   Int
  par      Int

  // Relations
  course     Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  holeScores HoleScore[]
  teeHoles   TeeHole[]

  @@unique([courseId, number])
  @@index([courseId])
}

model Tee {
  id       String  @id @default(cuid())
  courseId String
  name     String
  color    String?
  rating   Float
  slope    Int

  // Relations
  course Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  holes  TeeHole[]

  @@index([courseId])
}

model TeeHole {
  id           String @id @default(cuid())
  teeId        String
  holeId       String
  yards        Int
  handicapRank Int // 1-18 for stroke allocation from this tee

  // Relations
  tee  Tee  @relation(fields: [teeId], references: [id], onDelete: Cascade)
  hole Hole @relation(fields: [holeId], references: [id], onDelete: Cascade)

  @@unique([teeId, holeId])
  @@index([teeId])
  @@index([holeId])
}

model CourseArchitect {
  id        String @id @default(cuid())
  courseId  String
  name      String
  yearBuilt Int?

  // Relations
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
}

// Trip Management
model Trip {
  id             String   @id @default(cuid())
  name           String
  code           String   @unique
  startDate      DateTime
  endDate        DateTime
  buyInAmount    Float
  numberOfRounds Int
  purseTotal     Float    @default(0)
  isActive       Boolean  @default(true)
  createdBy      String
  createdAt      DateTime @default(now())

  // Relations
  creator  User         @relation("TripCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  players  TripPlayer[]
  courses  Course[]     @relation("TripCourses")
  teeTimes TeeTime[]
  prizes   Prize[]
  scores   RoundScore[]
  games    Game[]

  @@index([code])
  @@index([createdBy])
  @@index([isActive])
}

model TripPlayer {
  id       String   @id @default(cuid())
  tripId   String
  name     String
  handicap Float
  buyIn    Float
  joinedAt DateTime @default(now())

  // Relations
  trip   Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  scores RoundScore[]

  @@unique([tripId, name])
  @@index([tripId])
}

model TeeTime {
  id          String @id @default(cuid())
  tripId      String
  roundNumber Int
  time        String
  playerIds   String[] // Array of player IDs

  // Relations
  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, roundNumber])
}

model Prize {
  id          String    @id @default(cuid())
  tripId      String
  name        String
  type        PrizeType
  roundNumber Int?
  ctpHole     Int?
  amount      Float
  winnerId    String?

  // Relations
  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
}

// Score Tracking
model RoundScore {
  id           String      @id @default(cuid())
  tripId       String
  playerId     String
  userId       String?
  playerName   String
  roundNumber  Int
  courseId     String
  handicap     Float  // Handicap for this round
  grossTotal   Int         @default(0)
  netTotal     Int         @default(0)
  status       RoundStatus @default(NOT_STARTED)
  isComplete   Boolean     @default(false)
  ctpHole      Int?
  ctpDistance  String?
  updatedAt    DateTime    @updatedAt
  createdAt    DateTime    @default(now())

  // Relations
  trip   Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  player TripPlayer   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  user   User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  course Course       @relation(fields: [courseId], references: [id], onDelete: Restrict)
  holes  HoleScore[]

  @@unique([tripId, playerId, roundNumber])
  @@index([tripId, roundNumber])
  @@index([playerId])
}

model HoleScore {
  id              String @id @default(cuid())
  roundScoreId    String
  holeId          String
  holeNumber      Int
  grossScore      Int
  netScore        Int
  strokesReceived Int

  // Relations
  roundScore RoundScore @relation(fields: [roundScoreId], references: [id], onDelete: Cascade)
  hole       Hole       @relation(fields: [holeId], references: [id], onDelete: Restrict)

  @@unique([roundScoreId, holeNumber])
  @@index([roundScoreId])
}

// Enums
enum RoundStatus {
  NOT_STARTED
  STARTED
  FINISHED
  ABANDONED
}

enum PrizeType {
  CLOSEST_TO_PIN
  BEST_NET_ROUND
  BEST_CUMULATIVE_NET
  CUSTOM
}

// Game System
enum GameFormat {
  BEST_BALL
  COMBINED_SCORE
  HIGH_LOW
  MONEYBALL
  SKINS
  NASSAU
  SCRAMBLE
}

enum GamePlayType {
  MATCH_PLAY
  STROKE_PLAY
}

enum GameScoringType {
  GROSS
  NET
  BOTH
}

enum MatchStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Game {
  id          String          @id @default(cuid())
  tripId      String
  name        String
  format      GameFormat
  playType    GamePlayType
  scoringType GameScoringType
  roundNumber Int?
  buyInAmount Float           @default(0)
  purseTotal  Float           @default(0)
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())

  // Relations
  trip    Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  matches Match[]
  teams   Team[]

  @@index([tripId])
  @@index([tripId, roundNumber])
}

model Match {
  id             String      @id @default(cuid())
  gameId         String
  roundNumber    Int
  status         MatchStatus @default(PENDING)
  isTeamMatch    Boolean     @default(false)
  team1Id        String?
  team2Id        String?
  player1Id      String?
  player2Id      String?
  team1Score     Float?
  team2Score     Float?
  player1Score   Float?
  player2Score   Float?
  winnerId       String?
  winnerType     String? // 'team' or 'player'
  createdAt      DateTime    @default(now())

  // Relations
  game    Game  @relation(fields: [gameId], references: [id], onDelete: Cascade)
  team1   Team? @relation("Team1Matches", fields: [team1Id], references: [id], onDelete: SetNull)
  team2   Team? @relation("Team2Matches", fields: [team2Id], references: [id], onDelete: SetNull)

  @@index([gameId])
  @@index([roundNumber])
}

model Team {
  id        String   @id @default(cuid())
  gameId    String
  name      String
  playerIds String[] // Array of TripPlayer IDs
  createdAt DateTime @default(now())

  // Relations
  game           Game    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  team1Matches   Match[] @relation("Team1Matches")
  team2Matches   Match[] @relation("Team2Matches")

  @@index([gameId])
}

// Community Feature
model Community {
  id          String   @id @default(cuid())
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdBy   String
  createdAt   DateTime @default(now())

  // Relations
  creator User   @relation("CommunityCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  members User[] @relation("CommunityMembers")

  @@index([createdBy])
  @@index([isActive])
}
