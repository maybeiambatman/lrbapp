@baseUrl = http://localhost:3001

### Get all users
GET {{baseUrl}}/api/users

### Get user by email
GET {{baseUrl}}/api/users/email/admin@golf.com

### Create a new user
POST {{baseUrl}}/api/users
Content-Type: application/json

{
  "name": "John Administrator",
  "email": "john@golf.com",
  "isAdmin": true
}

### Create a regular user
POST {{baseUrl}}/api/users
Content-Type: application/json

{
  "name": "Jane Player",
  "email": "jane@golf.com",
  "isAdmin": false
}
