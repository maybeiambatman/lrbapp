@baseUrl = http://localhost:3001/api

###
# Get all games
GET {{baseUrl}}/games

###
# Get games for a specific trip
GET {{baseUrl}}/games?tripId=YOUR_TRIP_ID

###
# Get games for a specific round
GET {{baseUrl}}/games?roundNumber=1

###
# Get games by format
GET {{baseUrl}}/games?format=BEST_BALL

###
# Get active games only
GET {{baseUrl}}/games?isActive=true

###
# Get single game by ID
GET {{baseUrl}}/games/YOUR_GAME_ID

###
# Get game leaderboard
GET {{baseUrl}}/games/YOUR_GAME_ID/leaderboard

###
# Create a new game
POST {{baseUrl}}/games
Content-Type: application/json

{
  "tripId": "YOUR_TRIP_ID",
  "name": "Best Ball Round 1",
  "format": "BEST_BALL",
  "playType": "STROKE_PLAY",
  "scoringType": "NET",
  "roundNumber": 1,
  "buyInAmount": 20,
  "purseTotal": 80,
  "isActive": true
}

###
# Create a Match Play game
POST {{baseUrl}}/games
Content-Type: application/json

{
  "tripId": "YOUR_TRIP_ID",
  "name": "Singles Match Play",
  "format": "COMBINED_SCORE",
  "playType": "MATCH_PLAY",
  "scoringType": "GROSS",
  "roundNumber": 2,
  "buyInAmount": 25,
  "purseTotal": 100,
  "isActive": true
}

