###
# Update a game
PUT {{baseUrl}}/games/YOUR_GAME_ID
Content-Type: application/json

{
  "purseTotal": 100,
  "isActive": false
}

###
# Delete a game
DELETE {{baseUrl}}/games/YOUR_GAME_ID

###
# AVAILABLE GAME FORMATS:
# - BEST_BALL: Team format where best score on each hole counts
# - COMBINED_SCORE: Team format where both scores are combined
# - HIGH_LOW: One high, one low score counts
# - MONEYBALL: Rotating player whose score counts double
# - SKINS: Winner takes all for each hole
# - NASSAU: Three separate bets (front 9, back 9, overall)
# - SCRAMBLE: Best ball position, all play from there

###
# PLAY TYPES:
# - MATCH_PLAY: Head-to-head hole-by-hole competition
# - STROKE_PLAY: Total score competition

###
# SCORING TYPES:
# - GROSS: Actual score without handicap
# - NET: Score adjusted for handicap
# - BOTH: Track both gross and net scores
