@baseUrl = http://localhost:3001
@tripId = your-trip-id-here
@playerId = your-player-id-here
@courseId = your-course-id-here
@scoreId = your-score-id-here

### Get scores for a trip (all rounds)
GET {{baseUrl}}/api/scores/trip/{{tripId}}

### Get scores for a specific round
GET {{baseUrl}}/api/scores/trip/{{tripId}}?round=1

### Get player's scores across trips
GET {{baseUrl}}/api/scores/player/{{playerId}}

### Submit a complete round score
POST {{baseUrl}}/api/scores
Content-Type: application/json

{
  "tripId": "{{tripId}}",
  "playerId": "{{playerId}}",
  "playerName": "Tiger Woods",
  "roundNumber": 1,
  "courseId": "{{courseId}}",
  "handicap": 0.5,
  "grossTotal": 72,
